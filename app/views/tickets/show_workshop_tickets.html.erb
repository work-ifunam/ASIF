<% if current_user.category == "Admin TALLER" || current_user.category == "SAC" || current_user.category == "Sec COMPUTO" || current_user.category == "Dirección"%>
<h1>Solicitudes de Servicio en Taller (<%= @workshop_tickets.count.to_s %>)</h1>
<h2>Periodo: <%= 1.year.ago.strftime("%d/%m/%Y") + ' - ' + Date.current.strftime("%d/%m/%Y") %></h2>
<p>
<%= link_to "CREAR SOLICITUD DE SERVICIO", new_ticket_path(:department => "taller"), :class => "mylink2" %>
</p>
<h3><%= flash[:notice] if flash[:notice] %></h3>


<div class="stats">
<table id="mystats1">
  <caption>SOLICITUDES ACTIVAS EN TALLER </caption>
<!--  <caption>SOLICITUDES ACTIVAS EN TALLER (<%= @last_year + '-' + @current_year %>)</caption>-->
  <thead>
    <tr>
      <th></th>
      <th>NO ATENDIDOS (<%= @workshop_notattended.count.to_s %>)</th>
      <th>EN ESPERA (<%= @workshop_waiting.count.to_s %>)</th>
      <th>EN PROCESO (<%= @workshop_inprocess.count.to_s %>)</th>
      <th>EN REVISION (<%= @workshop_revision.count.to_s %>)</th>
      <th>ATENDIDOS (<%= @workshop_finished.count.to_s %>)</th>
      <th>CANCELADOS (<%= @workshop_canceled.count.to_s %>)</th>
    </tr>
  </tr>
  </thead>
  <tbody>
    <tr>
      <th></th>
      <td><%= @workshop_notattended.count.to_s %></td>
      <td><%= @workshop_waiting.count.to_s %></td>
      <td><%= @workshop_inprocess.count.to_s %></td>
      <td><%= @workshop_revision.count.to_s %></td>
      <td><%= @workshop_finished.count.to_s %></td>
      <td><%= @workshop_canceled.count.to_s %></td>
    </tr>
  </tbody>
</table>
</div>
<table width="790px">
  <tr>
  <td><center><%= link_to "NO ATENDIDOS (#{@workshop_notattended.count.to_s})", { :controller => "tickets", :action => "show_unattended_tickets", :department => "taller" }, :class => "mylink2" %></center></td>
  <td><center><%= link_to "EN ESPERA (#{@workshop_waiting.count.to_s})", { :controller => "tickets", :action => "show_froze_tickets", :department => "taller"}, :class => "mylink2" %></center></td>
  <td><center><%= link_to "EN PROCESO (#{@workshop_inprocess.count.to_s})", { :controller => "tickets", :action => "show_inprocess_tickets", :department => "taller"}, :class => "mylink2" %></center></td>
  <td><center><%= link_to "EN REVISION (#{@workshop_revision.count.to_s})", { :controller => "tickets", :action => "show_inrevision_tickets", :department => "taller"}, :class => "mylink2" %></center></td>
  <!--<td><center><%#= link_to "EN REVISION", { :controller => "tickets", :action => "show_inrevision_tickets", :department => "taller" ,:tech => current_user.tech}, :class => "mylink2" %></center></td>-->
  <td><center><%= link_to "ATENDIDOS (#{@workshop_finished.count.to_s})", { :controller => "tickets", :action => "show_attended_tickets", :department => "taller"}, :class => "mylink2" %></center></td>
  <td><center><%= link_to "CANCELADOS (#{@workshop_canceled.count.to_s})", { :controller => "tickets", :action => "show_canceled_tickets", :department => "taller"}, :class => "mylink2" %></center></td>
</tr>
</table>
<br />
<% @tickets.each do |ticket| %>
  <div class="ticket_title">
      <span class="ticket_number">No. <%= ticket.folio %> - <%= ticket.created_at.strftime("%m/%d/%Y - %H:%M:%S") %></span>
      <span class="ticket_category"><%= category = Category.find(ticket.category)
     				        category.name %></span>
  </div>  
  <div class="ticket_status">
      <strong><%= ticket.user.firstname + " " + ticket.user.lastname %></strong> solicita: 
      <%= ticket.description %><br />
  </div>
  <div class="ticket_content">

    <div class="accordion">
      <h3>Estado de la Solicitud</h3>
      <div>

    <table width="730px">
      <tr>
      <td width="40%">	
	<span class="ticket_responsible">Trabajo asignado a: </span><br />
	<% unless ticket.technicians.nil? %>
	    <% @technicians = ticket.technicians %>
	    <% @technicians.each do |tech| %>
	      <%= tech.firstname %> <%= tech.lastname %><br />
	    <% end %>
          <% end %>
      </td>
      <td width="50%">
      <%# if current_user.id == 182 && ticket.category == "19" %>
	<%#= link_to 'ADMINISTRAR SOLICITUD', edit_ticket_path(ticket, :department => ticket.department), :class => "mylink4" %><br />
      <%#  end %>
	<span class="ticket_responsible2">Fecha estimada de entrega:</span> 
	<small><%= unless ticket.ideal_time.nil?
	    ticket.ideal_time.strftime("%d/%m/%Y") 
	    end
	    %></small>
        <br/><span class="ticket_responsible2">Fecha de entrega:</span> 
	<small><%= unless ticket.ended_at.nil?
	    ticket.ended_at.strftime("%d/%m/%Y") 
	    end
	    %></small>
      </td>
      <td width="10%">
      <%= if ticket.status == "NO_ATENDIDO" 
            image_tag("/assets/noatendido.png", :alt => "no atendido") 
          elsif ticket.status == "EN_PROCESO"
            image_tag("/assets/enproceso.png", :alt => "en proceso") 
          elsif ticket.status == "EN_ESPERA" 
            image_tag("/assets/enespera.png", :alt => "en espera") 
          elsif ticket.status == "EN_REVISION" 
            image_tag("/assets/enrevision.png", :alt => "en revision")
          elsif ticket.status == "ENTREGADO" 
            image_tag("/assets/entregado.png", :alt => "entregado")
          elsif ticket.status == "CANCELADO" 
            image_tag("/assets/cancelado.png", :alt => "cancelado")
         end %>
         <br/>
      <%= if ticket.client_status == "APROBADO" 
            image_tag("/assets/aprobado.jpg", :alt => "aprobado") 
          elsif ticket.client_status == "NO_APROBADO"
            image_tag("/assets/noaprobado.jpg", :alt => "no aprobado") 
      end %>
      </td>
      </tr>
      </table>
      </div>
      <h3>Bit&aacute;cora de Observaciones</h3>
      <div>
	<%= simple_format h ticket.revision %>
      </div>
    </div>
  </div>
<% end %>
<%= paginate @tickets %>
<% end %>
