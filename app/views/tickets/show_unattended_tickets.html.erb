<%= if params[:department] == "computo" && current_user.category == "Admin COMPUTO"
       render 'computerua'
    elsif params[:department] == "electronica" && current_user.category == "Admin ELECTRONICA"
       render 'electronicua'
    elsif params[:department] == "taller" && current_user.category == "Admin TALLER"
       render 'workshopua'
    elsif params[:department] == "comunicacion" && current_user.category == "Admin COMUNICACION"
       render 'communicationua'
end %>
