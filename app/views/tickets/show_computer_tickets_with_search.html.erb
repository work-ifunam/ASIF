<% if current_user.category == "Admin COMPUTO" || current_user.category == "Chuck Norris" || current_user.category == "SAC" || current_user.category == "Sec COMPUTO" || current_user.category == "Dirección" %>
<h1 class="maintitle"><%= @search.department.upcase%> </h1>
<h1 class="subtitle text-center"><%= @search.category_name%> (<%= @computer_tickets.count.to_s %>)</h1>
<h4 class="subtitle"><%= link_to "CREAR SOLICITUD", new_ticket_path(:department => "computo"), :class => "btn btn-primary" %>
<%= link_to 'DESCARGAR RESULTADOS', url_for(:cat => @search.category.to_s, :date_from => @search.date_from.to_date.strftime("%d/%m/%Y").to_s, :date_to => @search.date_to.to_date.strftime("%d/%m/%Y").to_s , :format=>"xls"), :class=> "btn btn-secondary" %>
</h4>
<div class="row search-box">
  <div class="pull-right range-query">
    <%= form_tag show_computer_tickets_with_search_path, method: :get do %>
      Inicio: <%= text_field_tag 'search[date_from]', @search.date_from.to_date.strftime("%d/%m/%Y").to_s %>
      Fin: <%= text_field_tag 'search[date_to]', @search.date_to.to_date.strftime("%d/%m/%Y").to_s %>   
      <%= select_tag 'search[category]', options_from_collection_for_select(Category.where('department = ?', 'computo'), :id, :name),  :prompt => "Todas las categorías" %>
      <!--Atendio: <%#= select_tag 'search[technicians]', options_from_collection_for_select(Technician.where('category LIKE ?', '%COMPUTO%'), :id, :firstname),  :prompt => "Todos" %>-->
      <%= hidden_field_tag 'search[department]', @search.department.to_s %>
      <%= hidden_field_tag 'search[category_name]', @search.category_name.to_s %>
      <%= submit_tag 'Buscar', class: 'btn search-button' %>
    <% end %>
  </div>
</div>
<div class="stats text-center">
<div id="chart_div">
<table id="mystats1">
  <!--<caption>SOLICITUDES ACTIVAS EN <%= @search.department.upcase%> (<%#= @last_year + '-' + @current_year %>)</caption>-->
  <caption>PERIODO: </caption>
  <caption><%= @search.date_from.to_s + ' - ' + @search.date_to.to_s %></caption>
  <thead>
    <tr>
      <th></th>
      <th>NO ATENDIDOS (<%= @computer_notattended.count.to_s %>)</th>
      <th>EN ESPERA (<%= @computer_waiting.count.to_s %>)</th>
      <th>EN PROCESO (<%= @computer_inprocess.count.to_s %>)</th>
      <th>EN REVISION (<%= @computer_revision.count.to_s %>)</th>
      <th>ATENDIDOS (<%= @computer_finished.count.to_s %>)</th>
      <th>CANCELADOS (<%= @computer_canceled.count.to_s %>)</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <th></th>
      <td><%= @computer_notattended.count.to_s %></td>
      <td><%= @computer_waiting.count.to_s %></td>
      <td><%= @computer_inprocess.count.to_s %></td>
      <td><%= @computer_revision.count.to_s %></td>
      <td><%= @computer_finished.count.to_s %></td>
      <td><%= @computer_canceled.count.to_s %></td>
    </tr>
  </tbody>
</table></div>
</div>
<!---->
<div class="status-bar">
  <button class="btn btn-primary btn-notattended" <%= disabled = @computer_notattended.count == 0 ? 'disabled':''%> onclick="openStatus('notattended')">NO ATENDIDOS (<%=@computer_notattended.count.to_s%>)</button>
  <button class="btn btn-primary btn-waiting" <%= disabled = @computer_waiting.count == 0 ? 'disabled':''%> onclick="openStatus('waiting')">EN ESPERA (<%=@computer_waiting.count.to_s%>)</button>
  <button class="btn btn-primary btn-inprocess" <%= disabled = @computer_inprocess.count == 0 ? 'disabled':''%> onclick="openStatus('inprocess')">EN PROCESO (<%=@computer_inprocess.count.to_s%>)</button>
  <button class="btn btn-primary btn-revision"  <%= disabled = @computer_revision.count == 0 ? 'disabled':''%>  onclick="openStatus('revision')">EN REVISION (<%=@computer_revision.count.to_s%>)</button>
  <button class="btn btn-primary btn-finished" <%= disabled = @computer_finished.count == 0 ? 'disabled':''%> onclick="openStatus('finished')">ATENDIDOS (<%=@computer_finished.count.to_s%>)</button>
  <button class="btn btn-primary btn-canceled" <%= disabled = @computer_canceled.count == 0 ? 'disabled':''%> onclick="openStatus('canceled')">CANCELADOS (<%=@computer_canceled.count.to_s%>)</button>
</div>

<div id="notattended" class="w3-container status" style="display:none">
  <h4 class="subtitle">NO ATENDIDOS</h4>
  <% @tickets_notattended.each do |ticket| %>
    <%= render :partial => 'generic_ticket', locals: {ticket: ticket} %> 
  <% end %>
  <%= paginate @tickets_notattended%>
</div>

<div id="waiting" class="w3-container status" style="display:none">
  <h4 class="subtitle">EN ESPERA</h4>
  <% @tickets_waiting.each do |ticket| %>
    <%= render :partial => 'generic_ticket', locals: {ticket: ticket} %> 
  <% end %>
  <%= paginate @tickets_waiting%>
</div>

