<% if current_user.category == "Admin COMUNICACION" || current_user.category == "Chuck Norris" || current_user.category == "SAC" || current_user.category == "Sec COMPUTO" || current_user.category == "Dirección" %>

<h1>Solicitudes de la Unidad de Comunicaci&oacute;n (<%= @communication_tickets.count.to_s %>)</h1>
<h2>Periodo: <%= 1.year.ago.strftime("%d/%m/%Y") + ' - ' + Date.current.strftime("%d/%m/%Y") %></h2>
<p>
<%= link_to "CREAR SOLICITUD DE SERVICIO", new_ticket_path(:department => "comunicacion"), :class => "mylink2" %>
</p>

<h3><%= flash[:notice] if flash[:notice] %></h3>

<div class="stats">
<table id="mystats1">
  <caption>SOLICITUDES ACTIVAS EN UNIDAD DE COMUNICACION</caption>
  <thead>
    <tr>
      <th></th>
      <th>NO ATENDIDOS (<%= @communication_notattended.count.to_s %>)</th>
      <th>EN ESPERA (<%= @communication_waiting.count.to_s %>)</th>
      <th>EN PROCESO (<%= @communication_inprocess.count.to_s %>)</th>
      <th>EN REVISION (<%= @communication_revision.count.to_s %>)</th>
      <th>ATENDIDOS (<%= @communication_finished.count.to_s %>)</th>
      <th>CANCELADOS (<%= @communication_canceled.count.to_s %>)</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <th></th>
      <td><%= @communication_notattended.count.to_s %></td>
      <td><%= @communication_waiting.count.to_s %></td>
      <td><%= @communication_inprocess.count.to_s %></td>
      <td><%= @communication_revision.count.to_s %></td>
      <td><%= @communication_finished.count.to_s %></td>
      <td><%= @communication_canceled.count.to_s %></td>
    </tr>
  </tbody>
</table>
</div>
<table width="790px">
  <tr>
    <td><center><%= link_to "NO ATENDIDOS (#{@communication_notattended.count.to_s})", { :controller => "tickets", :action => "show_unattended_tickets", :department => "comunicacion" }, :class => "mylink2" %></center></td>
    <td><center><%= link_to "EN ESPERA (#{@communication_waiting.count.to_s})", { :controller => "tickets", :action => "show_froze_tickets", :department => "comunicacion"}, :class => "mylink2" %></center></td>
    <td><center><%= link_to "EN PROCESO (#{@communication_inprocess.count.to_s})", { :controller => "tickets", :action => "show_inprocess_tickets", :department => "comunicacion"}, :class => "mylink2" %></center></td>
    <!--<td><center><%= link_to "EN REVISION (#{@communication_revision.count.to_s})", { :controller => "tickets", :action => "show_inrevision_tickets", :department => "comunicacion"}, :class => "mylink2" %></center></td>-->
    <td><center><%= link_to "ATENDIDOS (#{@communication_finished.count.to_s})", { :controller => "tickets", :action => "show_attended_tickets", :department => "comunicacion"}, :class => "mylink2" %></center></td>
    <td><center><%= link_to "CANCELADOS (#{@communication_canceled.count.to_s})", { :controller => "tickets", :action => "show_canceled_tickets", :department => "comunicacion"}, :class => "mylink2" %></center></td>
  </tr>
</table>
<br />
<% @tickets.each do |ticket| %>
  <div class="ticket_title">
      <span class="ticket_number">No. <%= ticket.folio.to_s %> - <%= ticket.created_at.strftime("%m/%d/%Y - %H:%M:%S") %></span>
      <span class="ticket_category"><%= category = Category.find(ticket.category)
     				        category.name %></span>
  </div>  
  <div class="ticket_status">
      <strong><%= ticket.user.firstname + " " + ticket.user.lastname %></strong> solicita: 
      <%= ticket.description %><br />
  </div>
  <div class="ticket_content">

    <div class="accordion">
      <h3>Estado de la Solicitud</h3>
      <div>

    <table width="730px">
      <tr>
      <td width="40%">	
	<span class="ticket_responsible">Trabajo asignado a: </span><br />
	<% unless ticket.technicians.nil? %>
	    <% @technicians = ticket.technicians %>
	    <% @technicians.each do |tech| %>
	      <%= tech.firstname %> <%= tech.lastname %><br />
	    <% end %>
          <% end %>
      </td>
      <td width="50%">
      <% if current_user.category == "SAC" %>
	<%= link_to 'ADMINISTRAR SOLICITUD', edit_ticket_path(ticket, :department => ticket.department), :class => "mylink4" %><br />
      <% end %>
	<span class="ticket_responsible2">Fecha estimada de entrega:</span> 
	<small><%= unless ticket.ideal_time.nil?
	    ticket.ideal_time.strftime("%d/%m/%Y") 
	    end
	    %></small>
        <br/><span class="ticket_responsible2">Fecha de entrega:</span> 
	<small><%= unless ticket.ended_at.nil?
	    ticket.ended_at.strftime("%d/%m/%Y") 
	    end
	    %></small>
      </td>
      <td width="10%">
      <%= if ticket.status == "NO_ATENDIDO" 
            image_tag("/assets/noatendido.png", :alt => "no atendido") 
          elsif ticket.status == "EN_PROCESO"
            image_tag("/assets/enproceso.png", :alt => "en proceso") 
          elsif ticket.status == "EN_ESPERA" 
            image_tag("/assets/enespera.png", :alt => "en espera") 
          elsif ticket.status == "EN_REVISION" 
            image_tag("/assets/enrevision.png", :alt => "en revision")
          elsif ticket.status == "ENTREGADO" 
            image_tag("/assets/entregado.png", :alt => "entregado")
         end %>
         <br/>
      <%= if ticket.client_status == "APROBADO" 
            image_tag("/assets/aprobado.jpg", :alt => "aprobado") 
          elsif ticket.client_status == "NO_APROBADO"
            image_tag("/assets/noaprobado.jpg", :alt => "no aprobado") 
      end %>
      </td>
      </tr>
      </table>


      </div>
      <h3>Bit&aacute;cora de Observaciones</h3>
      <div>
	<%= simple_format h ticket.revision %>
      </div>
    </div>


  </div>
<% end %>
<%= paginate @tickets %>
<% end %>
