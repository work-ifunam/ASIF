<%= if params[:department] == "computo" && (current_user.category == "Admin COMPUTO" || current_user.category == "SAC" || current_user.category == "Sec COMPUTO" || current_user.category == "Dirección" )
       render 'computerip'
    elsif params[:department] == "electronica" && (current_user.category == "Admin ELECTRONICA" || current_user.category == "SAC" || current_user.category == "Sec COMPUTO" || current_user.category == "Dirección" )
       render 'electronicip'	
    elsif params[:department] == "taller" && (current_user.category == "Admin TALLER" || current_user.category == "SAC" || current_user.category == "Sec COMPUTO" || current_user.category == "Dirección" )
       render 'workshopip'	
    elsif params[:department] == "comunicacion" && (current_user.category == "Admin COMUNICACION" || current_user.category == "SAC" || current_user.category == "Sec COMPUTO" || current_user.category == "Dirección" )
       render 'communicationip'	
    elsif params[:department] == "mantenimiento" && (current_user.category == "Admin MANTENIMIENTO" || current_user.category == "SAC" || current_user.category == "Sec COMPUTO" || current_user.category == "Dirección" )
       render 'maintenancesip'
end %>
<%= paginate @tickets %>
