<div class="login-wrapper">
  <div class="login-card">
    
    <div class="login-card-header">
      <h1 class="login-title">Bienvenido/a</h1>
      <p class="login-subtitle">
        El acceso a esta sección es exclusivo para el personal del IFUNAM.<br />
        Por favor ingrese su usuario y contraseña de SALVA.
      </p>
    </div>

    <div class="login-card-body">
      <%= form_for @user_session, :as => :user_session, :url => { :action => "create" } do |f| %>
        <%= render 'shared/error_messages', :target => @user_session %>

        <div class="form-group">
          <label for="user_session_login">Usuario</label>
          <div class="input-group-domain">
            <%= f.text_field :login, class: "form-control", placeholder: "usuario", required: true %>
            <span class="domain-addon">@fisica.unam.mx</span>
          </div>
        </div>

        <div class="form-group">
          <label for="user_session_password">Contraseña</label>
          <%= f.password_field :password, class: "form-control", placeholder: "••••••••", required: true %>
        </div>

        <%= f.submit "Entrar", class: "btn-login-submit" %>
      <% end %>

      <a href="https://solicitudes.fisica.unam.mx/pr" target="_blank" class="forgot-password-link">
        ¿Olvidaste tu contraseña? Da clic aquí para restablecerla
      </a>

      <hr class="login-divider" />

    </div>

  </div>
</div>
