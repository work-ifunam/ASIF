<%= form_for(@user) do |f| %>
  <% if @user.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>

      <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :email %><br />
    <%= f.text_field :email %>
  </div>
  <div class="field">
    <%= f.label 'Nombre(s)' %><br />
    <%= f.text_field :firstname %>
  </div>
  <div class="field">
    <%= f.label 'Apellido' %><br />
    <%= f.text_field :lastname %>
  </div>
  <div class="field">
    <%= f.label 'Categoría' %><br />
    <%= f.select(:category, [
			['Administrador del Sistema ','Chuck Norris'],
			['Administrador de Cómputo','Admin COMPUTO'],
			['Administrador de Electrónica','Admin ELECTRONICA'],
			['Administrador de Unidad de Comunicación','Admin COMUNICACION'],
			['Administrador de Mantenimiento','Admin MANTENIMIENTO'],
			['Administrador de Taller','Admin TALLER'],
			['Administrador de Servicios','Admin SERVICIOS'],
			['Personal de cómputo', 'Personal COMPUTO'],
			['Personal de electrónica', 'Personal ELECTRONICA'],
			['Personal de unidad de comunicación', 'Personal COMUNICACION'],
			['Personal de taller', 'Personal TALLER'],
			['Personal de servicios', 'Personal SERVICIOS'],
			['Investigador', 'Investigador'],
			['Tec. Académico', 'Tec. Académico'],
			['Administrativo', 'Administrativo']
	]) %>
  </div>

  <div class="field">
  <%= f.label :password, f.object.new_record? ? nil : "Cambiar password" %><br />
  <%= f.password_field :password %>
  </div>

  <div class="field">
  <%= f.label 'Confirmación de Password' %><br />
  <%= f.password_field :password_confirmation %>
  </div>

  <div class="field">
    Login:<br />
    <%= f.text_field :login %>
  </div>

  <div class="field">
    Tech number<br />
    <%= f.text_field :tech %>
  </div>

  <div class="actions">
    <%= f.submit 'Crear usuario'%>
  </div>
<% end %>
