  <!-- ENCABEZADO Y ACCIONES -->
  <div class="header-flex-container">
    <div class="header-text-block">
      <h1 class="header-title">
	Usted tiene <%= @tickets.total_count %> solicitudes de servicio en <%= @department_name %>
      </h1>
    </div>

    <div class="header-actions-block">
      <%= link_to "CREAR SOLICITUD DE SERVICIO", new_ticket_path(:department => @department_slug), class: "btn btn-primary" %>
    </div>
  </div>

<% @tickets.each do |ticket| %>
  <div class="row">
    <div class="col-12 tickets-view">
      
      <!-- ENCABEZADO DEL TICKET -->
      <div class="ticket_title">
        <span class="ticket_number">
          No. <%= ticket.folio %> - <%= ticket.created_at.strftime("%d/%m/%Y - %H:%M:%S") %>
        </span>
        <span class="ticket_category">
          <% category = Category.find_by_id(ticket.category) %>
          <%= category ? category.name : '' %>
        </span>
      </div>  

      <!-- DETALLE DE LA SOLICITUD -->
      <div class="tickets-status-search">
        <strong><%= ticket.user.firstname %> <%= ticket.user.lastname %></strong> solicita: 
        <%= ticket.description.to_s.html_safe %><br />
      </div>

      <!-- CONTENIDO Y ACORDEÓN -->
      <div class="tickets-content-search">
        <div class="accordion">
          <h3>Estado de la Solicitud</h3>
          <div>
            <table width="100%">
              <tr>
                <!-- TÉCNICOS ASIGNADOS -->
                <td width="45%">
                  <% if ticket.technicians.present? %>
                    <p class="ticket_responsible">Trabajo asignado a: </p>
                    <% ticket.technicians.each do |tech| %>
                      <p class="ticket_responsible_name"><%= tech.firstname %> <%= tech.lastname %></p>
                    <% end %>
                  <% else %>
                    <h3 class="lbl-status lbl-notattended lbl-fit-content">SIN ASIGNAR</h3>
                  <% end %>
                </td>

                <!-- FECHAS Y BOTONES DE ACCIÓN -->
                <td width="45%">
                  <% if ticket.respond_to?(:schedule_time) && ticket.schedule_time %>
                    <p class="ticket_responsible2">Horario de atención: 
                      <small class="date"><%= ticket.schedule_time.strftime("%H:%M") %></small>
                    </p>
                  <% end %>

                  <% if ticket.ideal_time %>
                    <p class="ticket_responsible2">Fecha estimada de entrega: 
                      <small class="date"><%= ticket.ideal_time.strftime("%d/%m/%Y") %></small>
                    </p>
                  <% end %>

                  <% if ticket.ended_at %>
                    <p class="ticket_responsible2">Fecha de entrega: 
                      <small class="date"><%= ticket.ended_at.strftime("%d/%m/%Y") %></small>
                    </p>
                  <% end %>

                  <!-- ACCIONES DE ADMINISTRACIÓN Y CANCAN -->
                  <% if can? :edit, ticket %>
                    <%= link_to 'Administrar SOLICITUD', edit_ticket_path(ticket, department: ticket.department), class: "btn action-button line-3" %><br />
                  <% end %>

                  <% if can? :take, ticket %>
                    <%= button_to "Tomar Ticket", { controller: "tickets", action: "take_ticket", id: ticket.id }, method: :get, class: "btn action-button-taken" %>
                  <% end %>

                  <% if can? :close, ticket %>
                    <%= button_to "Cerrar Ticket", { controller: "tickets", action: "close_ticket", id: ticket.id }, method: :get, class: "btn action-button-closed" %>
                  <% end %>

                  <!-- APROBACIÓN POR PARTE DEL CLIENTE -->
                  <% if (ticket.status == "ENTREGADO" || ticket.status == "EN_REVISION") && ticket.client_status != "APROBADO" %>
                    <%= button_to "SI APRUEBO", { controller: "reports", action: "approve_ticket", id: ticket.id }, method: :get, class: "btn action-button-taken" %>
                  <% end %>

                  <% if ticket.status == "ENTREGADO" && ticket.client_status != "APROBADO" && ticket.client_status != "NO_APROBADO" %>
                    <%= button_to "NO APRUEBO", { controller: "reports", action: "not_approve_ticket", id: ticket.id }, method: :get, class: "btn action-button-closed" %>
                  <% end %>
                </td>

                <!-- ESTATUS BADGES -->
                <td width="10%">
                  <% case ticket.status %>
                  <% when "NO_ATENDIDO" %>
                    <h3 class="lbl-notattended lbl-status">NO ATENDIDO</h3>
                  <% when "EN_PROCESO" %>
                    <h3 class="lbl-inprocess lbl-status">EN PROCESO</h3>
                  <% when "EN_ESPERA" %>
                    <h3 class="lbl-waiting lbl-status">EN ESPERA</h3>
                  <% when "EN_REVISION" %>
                    <h3 class="lbl-revision lbl-status">EN REVISION</h3>
                  <% when "ENTREGADO" %>
                    <h3 class="lbl-finished lbl-status">ENTREGADO</h3>
                  <% when "CANCELADO" %>
                    <h3 class="lbl-canceled lbl-status">CANCELADO</h3>
                  <% end %>

                  <% if ticket.client_status == "APROBADO" %>
                    <h3 class="lbl-approved lbl-status">Aprobado</h3>
                  <% elsif ticket.client_status == "NO_APROBADO" %>
                    <h3 class="lbl-notapproved lbl-status">No Aprobado</h3>
                  <% end %>
                </td>
              </tr>
            </table>
          </div>

          <!-- BITÁCORA DE OBSERVACIONES -->
          <% if ticket.revision.present? %>
            <h3>Bit&aacute;cora de Observaciones</h3>
            <div>
              <%= simple_format h(ticket.revision) %>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
<% end %>

<%= paginate @tickets %>
