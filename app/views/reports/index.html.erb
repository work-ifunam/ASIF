<span class="username">Sesión de <%= current_user.firstname %> <%= current_user.lastname %></span> - <span class="category"><%= current_user.category %></span>

<p>
  Bienvenido/a. A través de este panel usted podrá llevar un seguimiento de sus solicitudes de servicio. Por favor seleccione una de las siguientes opciones para comenzar:
</p>

<% if can? :read, :show_personal_tickets %>
  <h3>Asignadas</h3>
  <ul>
    <li><%= link_to 'Mis solicitudes', show_personal_tickets_path, class: "mylink3" %></li>
  </ul>
<% end %>

<h3>Solicitadas</h3>
<ul>
  <li><%= link_to 'Cómputo', department_reports_path('computo'), class: "mylink3" %></li>
  <li><%= link_to 'Taller', department_reports_path('taller'), class: "mylink3" %></li>
  <li><%= link_to 'Electrónica', department_reports_path('electronica'), class: "mylink3" %></li>
  <li><%= link_to 'Comunicación', department_reports_path('comunicacion'), class: "mylink3" %></li>
  <li><%= link_to 'Mantenimiento', department_reports_path('mantenimiento'), class: "mylink3" %></li>
</ul>

<div class="stats">
  <table id="mystats1">
    <caption>Solicitudes de <%= current_user.firstname %> <%= current_user.lastname %></caption>
    <thead>
      <tr>
        <th></th>
        <th>CÓMPUTO</th>
        <th>TALLER</th>
        <th>ELECTRÓNICA</th>
        <th>COMUNICACIÓN</th>
        <th>MANTENIMIENTO</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th></th>
        <td><%= @my_computer.size %></td>
        <td><%= @my_workshop.size %></td>
        <td><%= @my_electronic.size %></td>
        <td><%= @my_communication.size %></td>
        <td><%= @my_maintenance.size %></td>
      </tr>
    </tbody>
  </table>
</div>
