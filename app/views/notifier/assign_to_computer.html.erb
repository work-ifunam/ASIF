<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 6px; background-color: #ffffff; overflow: hidden;">
  
  <div style="background-color: #0056b3; color: #ffffff; padding: 15px 20px; font-size: 14px; border-bottom: 3px solid #003d82;">
    <span style="float: right; font-weight: bold;">SOLICITUD No. <%= @folio %></span>
    <span style="font-weight: bold;">TIENE UNA NUEVA ASIGNACIÓN EN ASIF</span>
    <div style="clear: both;"></div>
  </div>

  <div style="padding: 20px; background-color: #f8f9fa; border-bottom: 1px solid #e0e0e0;">
    <div>
      <div>
        <h2 style="margin: 0 0 15px 0; font-size: 20px; color: #333333;"><%= @category.name %></h2>
        
        <div style="margin-bottom: 10px; font-size: 14px; color: #555555;">
          <span style="display: inline-block; margin-right: 15px;"><strong>SOLICITANTE:</strong> <%= @user.firstname %> <%= @user.lastname %></span>
	  <% if @location.present? %>
  	  <span style="display: inline-block;"><strong>UBICACIÓN:</strong> <%= @location %></span> 
	  <% end %>
        </div>
        
        <div style="font-size: 14px; color: #555555;">
          <span><strong>CONTACTO:</strong> <%= @user.email %> | <% if @extension.present? %><strong>Ext:</strong> <%= @ext %><% end %></span>
        </div>
      </div>
    </div>
  </div>

  <div style="padding: 20px;">
    <div style="background-color: #ffffff; border: 1px solid #e9ecef; border-left: 4px solid #0056b3; padding: 15px; margin-bottom: 25px; border-radius: 4px; color: #444444; font-size: 14px; line-height: 1.6;">
      <div style="margin: 0;">
	<%= simple_format(sanitize(@description, tags: %w(b i u strong em a br p ul li hr))) %>
      </div>
    </div>

    <div style="text-align: center; margin-top: 20px; margin-bottom: 10px;">
      <a href="https://asif.fisica.unam.mx/tickets/<%= @id %>/edit?department=<%= @link %>" style="display: inline-block; padding: 12px 25px; background-color: #0056b3; color: #ffffff; text-decoration: none; font-weight: bold; border-radius: 4px; font-size: 14px; text-transform: uppercase;">
        ATENDER SOLICITUD
      </a>
    </div>
  </div>
</div>
