!!!
%html{:xmlns => "http://www.w3.org/1999/xhtml", "xml:lang" => "es", :lang => "es"}
  %head
    %title ASIF - Iniciar Sesión
    %meta{"http-equiv" => "content-type", "content" => "text/html; charset=ISO-8859-1"}
    %meta{"http-equiv" => "content-language", "content" => "es"}
    %meta{"http-equiv" => "description", "content" => "ASIF Login"}
    %meta{"http-equiv" => "keywords", "content" => "ASIF, IFUNAM"}
    %meta{"http-equiv" => "author", "content" => "Daniel Rosales"}
    %meta{"http-equiv" => "copyright", "content" => "IFUNAM"}
    %link{"rel" => "stylesheet", "type" => "text/css", "href" => "https://fonts.googleapis.com/css?family=Montserrat"}
    %link{"rel" => "shortcut icon", "href" => "../assets/favicon.ico"}
    = stylesheet_link_tag "application"
    = stylesheet_link_tag "users_session"
    = javascript_include_tag "https://kit.fontawesome.com/b8078faaf5.js"
    = javascript_include_tag "application"
  %body
    %div#wrapper
      %div#header1
        %div#title
          ASIF  
        %div#title2
          Administrador de Solicitudes del Instituto de F&iacute;sica
      %div#main_content
        %div#content{:style => "width: 100%; margin: 0;"}
          - flash.each do |type, msg|
            %div{:class => "flash #{type}"}= msg
          = yield      
      %div.clear

    %footer#footer.main-footer
      .footer-content
        .footer-brand
          %p.footer-institution
            = @current_year
            Instituto de F&iacute;sica, UNAM
          %p.footer-address Circuito de la Investigación Científica s/n, Ciudad Universitaria, C.P. 04510, Ciudad de México.
          %p.footer-address.text-center
            contacto:
            = link_to 'daniel@fisica.unam.mx', 'mailto:daniel@fisica.unam.mx', target: '_blank'
        .footer-rights
          %p.footer-institution.text-center
            = link_to 'Avisos de Privacidad', 'https://www.fisica.unam.mx/privacidad/?lang=es', target: '_blank'
          %p.footer-subtext
