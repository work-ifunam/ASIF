   // Load the Visualization API and the corechart package.
   google.charts.load('current', {'packages':['corechart']});
   // Set a callback to run when the Google Visualization API is loaded.
   google.charts.setOnLoadCallback(function() {
   $(document).ready(drawChart);
   });
   
   // Callback that creates and populates a data table,
   // instantiates the pie chart, passes in the data and
   // draws it.
   function drawChart() {
   var container = document.getElementById('chart_div');
   if (!container) return;
   // Create the data table.
   var data = new google.visualization.DataTable();
   data.addColumn('string', 'Topping');
   data.addColumn('number', 'Slices');
   data.addRows([['Mushrooms', 3],['Onions', 1],['Olives', 1],['Zucchini', 1],['Pepperoni', 2]]);
   // Set chart options
   var options = {'title':'How Much Pizza I Ate Last Night','width':720,'height':300, colors: ['#AA0001','#008080', '#D4AA01', '#D45508', '#028001', '#6d0202'], pieHole: 0.4 };
   // Instantiate and draw our chart, passing in some options.
   var chart = new google.visualization.PieChart(container);
   chart.draw(data, options);
   }
 %body
  %div#wrapper
   %div#header1
    %div#title
     ASIF  
    %div#title2
     Administrador de Solicitudes del Instituto de F&iacute;sica
   %div#main_content
    %div#left_menu
     =image_tag("icono_computo.png")
     %ul
      %li 
       = link_to 'Mis Solicitudes', home_path
      %li 
       - if current_user.category == "Admin COMPUTO"
        = link_to 'Solicitudes en Cómputo', tickets_path
       - elsif current_user.category == 'SAC' || current_user.category == "Dirección" || current_user.category == 'Sec COMPUTO'
        = link_to 'Solicitudes en Cómputo', show_computer_tickets_path
       - else
        = link_to 'Solicitudes en Cómputo',my_computer_reports_path
      %li
       - if current_user.category == "Admin TALLER"
        = link_to 'Solicitudes en Taller', tickets_path
       - elsif current_user.category == 'SAC' || current_user.category == 'Sec COMPUTO' || current_user.category == "Dirección"
        = link_to 'Solicitudes en Taller', show_workshop_tickets_path
       - else
        = link_to 'Solicitudes en Taller', my_workshop_reports_path
        =# link_to 'Solicitudes en Taller', show_workshop_tickets_path
      %li
       - if current_user.category == "Admin ELECTRONICA" || current_user.category == 'SAC' 
        = link_to 'Solicitudes en Electrónica', tickets_path
       - elsif current_user.category == 'Sec COMPUTO' || current_user.category == "Dirección"
        = link_to 'Solicitudes en Electrónica', show_electronic_tickets_path 
       - else
        = link_to 'Solicitudes en Electrónica',my_electronic_reports_path
      %li
       - if current_user.category == "Admin COMUNICACION" 
        = link_to 'Solicitudes en Unidad de Comunicación', tickets_path
       - elsif current_user.category == 'SAC' || current_user.category == 'Sec COMPUTO' || current_user.category == "Dirección"
        = link_to 'Solicitudes en Unidad de Comunicación', show_communication_tickets_path 
       - else
        = link_to 'Solicitudes en Unidad de Comunicación',my_communication_reports_path
      %li
       - if current_user.category == "Admin MANTENIMIENTO"
        = link_to 'Solicitudes en Mantenimiento', tickets_path
       - elsif current_user.category == 'SAC' || current_user.category == 'Sec COMPUTO' || current_user.category == "Dirección"
        = link_to 'Solicitudes en Mantenimiento', show_maintenance_tickets_path 
       - else
        = link_to 'Solicitudes en Mantenimiento', my_maintenance_reports_path
      %li
       = link_to 'Salir', logout_path 
    %div#content
     = yield  
   %div#footer
