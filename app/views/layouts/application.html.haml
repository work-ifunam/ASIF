!!!
%html{:xmlns => "http://www.w3.org/1999/xhtml", "xml:lang" => "es", :lang => "es"}
 %head
  %title ASIF 
  %meta{"http-equiv" => "content-type", "content" => "text/html; charset=ISO-8859-1"}
  %meta{"http-equiv" => "content-language", "content" => "es"}
  %meta{"http-equiv" => "description", "content" => "ASIF"}
  %meta{"http-equiv" => "keywords", "content" => "ASIF"}
  %meta{"http-equiv" => "author", "content" => "Daniel Rosales"}
  %meta{"http-equiv" => "copyright", "content" => "IFUNAM"}
  %link{"rel" => "stylesheet", "type" => "text/css", "href" => "https://fonts.googleapis.com/css?family=Montserrat"}
  %link{"rel" => "shortcut icon", "href" => "../assets/favicon.ico"}
  = stylesheet_link_tag "application"
  = stylesheet_link_tag "jquery-ui"
  = javascript_include_tag "https://www.gstatic.com/charts/loader.js"
  = javascript_include_tag "https://kit.fontawesome.com/b8078faaf5.js"
  = javascript_include_tag "application"
  = javascript_include_tag "jquery-ui"
  = javascript_include_tag "jquery.gvChart-1.1.min"
  %script{"type" => "text/javascript"}
   $(function() {
   $( ".accordion" ).accordion({
   heightStyle: "content"
   });
   });
  %script{"type" => "text/javascript"}
   $(document).ready(function(){
   googleLoaded.done( function(){
   if($('#mystats1').length) {
   $('#mystats1').gvChart({
   chartType: 'PieChart',
   gvSettings: {
   vAxis: {title: 'Mis solicitudes'},
   fontName: 'Montserrat',
   hAxis: {title: ' '},
   tooltip: {text: 'percentage'},
   colors: ['#AA0001','#008080', '#D4AA01', '#D45508', '#028001', '#6d0202'],
   pieHole: 0.4,
   width: 820,
   height: 300,
   }
   });
   }
   });
   });
 %body
  %div#wrapper
   %div#header1
    %div#title
     ASIF  
    %div#title2
     Administrador de Solicitudes del Instituto de F&iacute;sica
   %div#main_content
    %div#left_menu
     = image_tag(current_department_icon)
     %ul
      %li 
       = link_to 'Mis Solicitudes', home_path

      %li 
       - if can? :read, :show_computer_tickets_with_advanced_search
        = link_to 'Solicitudes en Cómputo', show_computer_tickets_with_advanced_search_path 
       - else
        = link_to 'Solicitudes en Cómputo', department_reports_path('computo')

      %li
       - if can? :read, :show_workshop_tickets
        = link_to 'Solicitudes en Taller', tickets_path
       - elsif can? :read, :show_workshop_tickets_with_search
        = link_to 'Solicitudes en Taller', show_workshop_tickets_with_search_path
       - else
        = link_to 'Solicitudes en Taller', department_reports_path('taller')

      %li
       - if can? :read, :show_electronic_tickets_with_advanced_search
        = link_to 'Solicitudes en Electrónica', show_electronic_tickets_with_advanced_search_path 
       - else
        = link_to 'Solicitudes en Electrónica', department_reports_path('electronica')

      %li
       - if can? :read, :show_communication_tickets_with_advanced_search
        = link_to 'Solicitudes en Unidad de Comunicación', show_communication_tickets_with_advanced_search_path
       - else
        = link_to 'Solicitudes en Unidad de Comunicación', department_reports_path('comunicacion')

      %li
       - if can? :read, :show_maintenance_tickets_with_advanced_search
        = link_to 'Solicitudes en Mantenimiento', show_maintenance_tickets_with_advanced_search_path
       - else
        = link_to 'Solicitudes en Mantenimiento', department_reports_path('mantenimiento')

      %li
       = link_to 'Salir', logout_path 
    %div#content
     -# Despliegue de mensajes flash (login, errores, notificaciones)
     - flash.each do |type, msg|
      %div{:class => "flash #{type}"}= msg
     = yield      
   %div#footer
    Instituto de F&iacute;sica UNAM -
    = @current_year
   %div.clear
