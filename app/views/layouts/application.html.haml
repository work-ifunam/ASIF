!!!
%html{:xmlns => "http://www.w3.org/1999/xhtml", "xml:lang" => "es", :lang => "es"}
 %head
  %title ASIF 
  %meta{"http-equiv" => "content-type", "content" => "text/html; charset=ISO-8859-1"}
  %meta{"http-equiv" => "content-language", "content" => "es"}
  %meta{"http-equiv" => "description", "content" => "ASIF"}
  %meta{"http-equiv" => "keywords", "content" => "ASIF"}
  %meta{"http-equiv" => "author", "content" => "Daniel Rosales"}
  %meta{"http-equiv" => "copyright", "content" => "IFUNAM"}
  %link{"rel" => "stylesheet", "type" => "text/css", "href" => "https://fonts.googleapis.com/css?family=Montserrat"}
  %link{"rel" => "shortcut icon", "href" => "../assets/favicon.ico"}
  = stylesheet_link_tag "application"
  = stylesheet_link_tag "jquery-ui"
  = javascript_include_tag "https://www.google.com/jsapi"
  = javascript_include_tag "https://kit.fontawesome.com/b8078faaf5.js"
  = javascript_include_tag "application"
  = javascript_include_tag "jquery.gvChart-1.1.min"
  %script{"type" => "text/javascript"}
   $(function() {
   $( ".accordion" ).accordion({
   heightStyle: "content"
   });
   });
  %script{"type" => "text/javascript"}
   //gvChartInit();
   //jQuery(document).ready(function(){
   //jQuery('#mystats1').gvChart({
   //chartType: 'PieChart',
   //gvSettings: {
   //vAxis: {title: 'Mis solicitudes de Servicio'},
   //hAxis: {title: ' '},
   //width: 700,
   //height: 300
   //}
   //});
   //});
   googleLoaded.done( function(){
   $('#mystats1').gvChart({
   chartType: 'PieChart',
   gvSettings: {
   vAxis: {title: 'Mis solicitudes'},
   hAxis: {title: ' '},
   tooltip: {text: 'percentage'},
   colors: ['#AA0001','#008080', '#D4AA01', '#D45508', '#028001', '#6d0202'],
   pieHole: 0.4,
   width: 820,
   height: 300,
   }
   });
   });
 %body
  %div#wrapper
   %div#header1
    %div#title
     ASIF  
    %div#title2
     Administrador de Solicitudes del Instituto de F&iacute;sica
   %div#main_content
    %div#left_menu
     =image_tag("icono_computo.png")
     %ul
      %li 
       = link_to 'Mis Solicitudes', home_path
      %li 
       - if current_user.category == "Admin COMPUTO"
        = link_to 'Solicitudes en Cómputo', tickets_path
       - elsif current_user.category == 'SAC' || current_user.category == 'Sec COMPUTO' || current_user.category == "Dirección"
        = link_to 'Cómputo', show_computer_tickets_with_search_path
       - else
        = link_to 'Solicitudes en Cómputo',my_computer_reports_path
      %li
       - if current_user.category == "Admin TALLER"
        = link_to 'Solicitudes en Taller', tickets_path
       - elsif current_user.category == 'SAC' || current_user.category == 'Sec COMPUTO' || current_user.category == "Dirección"
        = link_to 'Taller', show_workshop_tickets_with_search_path
       - else
        = link_to 'Solicitudes en Taller', my_workshop_reports_path
        =# link_to 'Solicitudes en Taller', show_workshop_tickets_path
      %li
       - if current_user.category == "Admin ELECTRONICA"  
        =# link_to 'Solicitudes en Electrónica', tickets_path
        = link_to 'Electrónica', show_electronic_tickets_with_advanced_search_path 
       - elsif current_user.category == 'SAC' || current_user.category == 'Sec COMPUTO' || current_user.category == "Dirección" 
        = link_to 'Electrónica', show_electronic_tickets_with_advanced_search_path 
       - else
        = link_to 'Solicitudes en Electrónica',my_electronic_reports_path
      %li
       - if current_user.category == "Admin COMUNICACION" 
        = link_to 'Solicitudes en Unidad de Comunicación', tickets_path
       - elsif current_user.category == 'SAC' || current_user.category == 'Sec COMPUTO' || current_user.category == "Dirección" 
        = link_to 'Comunicación', show_communication_tickets_with_search_path 
       - else
        = link_to 'Solicitudes en Unidad de Comunicación',my_communication_reports_path
      %li
       - if current_user.category == "Admin MANTENIMIENTO"
        = link_to 'Solicitudes en Mantenimiento', tickets_path
       - elsif current_user.category == 'SAC' || current_user.category == 'Sec COMPUTO' || current_user.category == "Dirección"
        = link_to 'Mantenimiento', show_maintenance_tickets_with_search_path 
       - else
        = link_to 'Solicitudes en Mantenimiento', my_maintenance_reports_path
      %li
       = link_to 'Salir', logout_path 
    %div#content
     = yield      
   %div#footer
    Instituto de F&iacute;sica UNAM -
    = @current_year
   %div.clear
